{
  "name": "wobblies-monorepo",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "api:check": "turbo run api:check",
    "api:update": "turbo run api:update",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "gallery": "turbo run build --filter=@wobblies/core && tsx scripts/gallery.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3"
  }
}
