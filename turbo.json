{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "size": { "dependsOn": ["^build", "build"] },
    "check:exports": { "dependsOn": ["^build", "build"] },
    "api:check": { "dependsOn": ["build"] },
    "api:update": { "dependsOn": ["build"], "cache": false }
  }
}
